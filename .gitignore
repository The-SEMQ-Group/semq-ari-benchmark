# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Committed ARI reports live in leaderboard/submissions/ (they back the leaderboard rows).
# Only ad-hoc scratch runs are ignored:
leaderboard/submissions/scratch/

# Python build artifacts
build/
dist/

# Generated static Space artifact — derived from leaderboard.json + app/ via build_static.py.
# The CI regenerates it on deploy; leaderboard.json + the app are the source of truth.
leaderboard/static/index.html

# refresh_leaderboard.py --mock scratch
leaderboard/_mock_submissions/
leaderboard/submissions/attestation-repo/

# Regime-discrimination embedding cache (48M, regenerated by run_matrix.py)
experiments/regime-discrimination/results/cache/
experiments/decoding-reproducibility/results/cache/
# Probe-sweep 1024-dim cache (24M, regenerated by run_matrix.py --limit)
experiments/probe-sweep/cache-bge-large/
# Probe-sweep outputs are generated; publish immutable runs with their manifest.
experiments/probe-sweep/results/*.json
experiments/probe-sweep/results/*.npz
infra/.last-instance
experiments/harness-effect/results/attestation-repo/
experiments/*/results/attestation-repo/

# Local and generated documentation/build artifacts
*.log
.Rhistory
*.synctex.gz
.DS_Store
