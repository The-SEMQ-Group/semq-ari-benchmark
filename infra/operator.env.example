# Operator-only AWS coordinates. Copy to infra/operator.env (gitignored) and
# fill in. launch.sh substitutes the CA_* values into bootstrap.sh at launch;
# ari/README.md sources this file for a local install. Nothing here is
# committed, so the public tree names no account, domain, repository or bucket.
CA_DOMAIN=
CA_REPO=
CA_REGION=
CA_OWNER=
BASELINES_BUCKET=
BATCH_RESULTS_BUCKET=
# Research results bucket: archived experiment bundles and the embedding cache
# (docs/paper/EVIDENCE.md names its prefixes through this variable).
RESEARCH_RESULTS_BUCKET=
